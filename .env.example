# ZapLink settings
# Copy to .env (cp .env.example .env), fill in DATABASE_PASSWORD, then: docker compose up -d --build
# Every other setting, with its default, is listed in .env.reference. Most can also be changed
# from the dashboard (Infrastructure page); a value written here overrides the dashboard.

# --- Required ---------------------------------------------------------------
# Password for the bundled PostgreSQL. Pick a long random one and keep it safe.
DATABASE_PASSWORD=

# --- App --------------------------------------------------------------------
NODE_ENV=production
# Port on your machine where the dashboard and API open (http://localhost:2785)
API_PORT=2785
# error | warn | info | debug
LOG_LEVEL=info
# TZ=Asia/Karachi

# --- Optional ---------------------------------------------------------------
# Public address, when it runs behind a domain
# BASE_URL=https://api.yourdomain.com

# WhatsApp engine: pick it in the dashboard (Infrastructure > Engine). Default: baileys.
# Setting it here pins the engine and disables the dashboard switch.
# ENGINE_TYPE=baileys

# Docker limits for the API container
ZAPLINK_MEM_LIMIT=2g
ZAPLINK_PIDS_LIMIT=2048
