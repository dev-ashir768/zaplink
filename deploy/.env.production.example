# ZapLink production settings (Linux VPS, 100+ WhatsApp numbers)
# deploy/install.sh creates .env from this file and fills in the passwords for you.
# Every other setting, with its default, is listed in .env.reference.

# --- Domain and HTTPS ------------------------------------------------------
# The domain that points at this server (A record). Caddy gets the HTTPS certificate for it.
ZAPLINK_DOMAIN=wa.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=admin@example.com

# --- Secrets (generated by install.sh, keep them safe) ---------------------
DATABASE_PASSWORD=
REDIS_PASSWORD=

# --- App -------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Karachi

# baileys: light, 100+ numbers on one server (recommended)
# whatsapp-web.js: runs a Chrome per number, ~300-500 MB RAM each
ENGINE_TYPE=baileys
# Upper limit on numbers running at the same time (0 = no limit)
MAX_CONCURRENT_SESSIONS=150
# Reconnect every number automatically after a restart
AUTO_START_SESSIONS=true

# --- Server size -----------------------------------------------------------
# Recommended for 100-150 numbers on Baileys: 4 vCPU, 16 GB RAM, 100 GB SSD.
ZAPLINK_MEM_LIMIT=8g
ZAPLINK_PIDS_LIMIT=4096
DATABASE_POOL_SIZE=40
# About 1/4 and 3/4 of the RAM you leave for PostgreSQL
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# --- Backups ---------------------------------------------------------------
# Where deploy/zaplink.sh backup writes, and how many days to keep
BACKUP_DIR=/var/backups/zaplink
BACKUP_KEEP_DAYS=14
