{
    "name": "rmyndharis/zaplink",
    "description": "Official PHP SDK for ZapLink, the open-source WhatsApp API Gateway (not affiliated with WhatsApp or Meta)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "zaplink",
        "gateway"
    ],
    "authors": [
        {
            "name": "ZapLink Contributors"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ZapLink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZapLink\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    }
}
